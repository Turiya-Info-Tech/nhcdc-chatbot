# Copy to ".env" on the server and fill in. NEVER commit ".env".

DOMAIN=bot.yourdomain.com

# --- docker-compose.vps.yml (shared VPS with Traefik + Postgres container) ---
DB_HOST=veena-postgres
DB_PORT=5432
PG_NETWORK=              # docker network the Postgres container is on
TRAEFIK_NETWORK=         # docker network Traefik uses (often the same as PG_NETWORK)
TRAEFIK_CERT_RESOLVER=   # name of Traefik's Let's Encrypt resolver
TRAEFIK_ENTRYPOINT=websecure
DB_NAME=nhcdc_chatbot
DB_USERNAME=nhcdc
DB_PASSWORD=change-me-long-random

# meta (Meta Cloud API directly) or turiya (Turiya gateway)
WHATSAPP_PROVIDER=turiya

# used when WHATSAPP_PROVIDER=turiya
TURIYA_BASE_URL=https://app.turiyainfotech.com
TURIYA_API_KEY=
TURIYA_WABA_NUMBER=

# used when WHATSAPP_PROVIDER=meta
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=change-me-random-string

ADMIN_API_USERNAME=admin
ADMIN_API_PASSWORD=change-me-strong

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Leads
